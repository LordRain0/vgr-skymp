{
  "name": "vengeful-realms-launcher",
  "version": "2.1.0",
  "description": "Launcher for the Vengeful Realms server",
  "main": "src/main.js",
  "author": "F02K, Suraru, Metadraconis",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "7zip-bin-full": "^26.2.1",
    "adm-zip": "^0.6.0",
    "dotenv": "^17.4.2",
    "electron-store": "^11.0.2"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.vengefulrealms.launcher",
    "productName": "Vengeful Realms Launcher",
    "directories": {
      "output": "../build/launcher"
    },
    "afterAllArtifactBuild": "scripts/write-launcher-version.js",
    "files": [
      "src/**/*",
      "assets/**/*",
      ".env",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon_notext.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon_notext.ico",
      "uninstallerIcon": "assets/icon_notext.ico",
      "artifactName": "VengefulRealmsLauncher.exe",
      "include": "installer.nsh"
    },
    "asarUnpack": [
      "node_modules/7zip-bin-full/**"
    ]
  }
}
